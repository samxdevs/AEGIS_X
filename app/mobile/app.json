{
  "expo": {
    "name": "AEGIS",
    "slug": "aegis",
    "scheme": "aegis",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.sih.aegis",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AEGIS connects directly to the field pod over local Wi-Fi to collect advisories. Nothing is sent anywhere else.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "in.sih.aegis",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "AEGIS listens only after you tap the microphone on the Ask tab, so you can ask about your fields in your own language."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AEGIS uses this phone's location while you walk a field, so it can mark on the map where problems are. It is only read while a scan is running."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
